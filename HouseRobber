class Solution {
    /**
    Time: o(n)
    Space:o(n)
    */
    public int rob(int[] nums) {
        if (nums == null || nums.length == 0)
            return 0;
        if (nums.length == 1)
            return nums[0];
        int dp[] = new int[nums.length];
        dp[0] = nums[0];
        dp[1] = Math.max(dp[0], nums[1]);
        for (int i = 2; i < nums.length; i++) {
            //max(dont choose,choose)
            //dont choose => dp[i-1]
            //choose: current num earnings+ 2 earnings from 2 stesps back because I cant choose previous house but I can choose previous to previous house
            dp[i] = Math.max(dp[i - 1], nums[i] + dp[i - 2]);
        }

        return dp[nums.length - 1];
    }

    /**
     Time: o(n)
     Space:o(1)
     */
    public int robOptimized(int[] nums) {
        if (nums == null || nums.length == 0)
            return 0;
        if (nums.length == 1)
            return nums[0];
        int prevPrev = 0;
        int prev = nums[0];
        int curr = Math.max(prev, nums[1]);
        for (int i = 2; i < nums.length; i++) {
            //max(dont choose,choose)
            //dont choose => dp[i-1]
            //choose: current num earnings+ 2 earnings from 2 stesps back because I cant choose previous house but I can choose previous to previous house
            prevPrev = prev;
            prev = curr;
            curr = Math.max(prev, nums[i] + prevPrev);
        }

        return curr;
    }
}